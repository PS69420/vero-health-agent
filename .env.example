# Copy to .env and fill in your real values. .env is gitignored -- never commit it.

# Vapi private API key (Vapi dashboard -> API Keys)
VAPI_API_KEY=

# The Vapi assistant that places outbound compliance check-in calls
VAPI_ASSISTANT_ID=

# The Vapi-provisioned phone number the call goes FROM
VAPI_PHONE_NUMBER_ID=

# TEST MODE: every call placed via console/server.py goes to this number
# instead of a real patient's (patient records don't have phone numbers
# yet). Remove this override once real patient numbers are wired in.
VAPI_TEST_OVERRIDE_NUMBER=
